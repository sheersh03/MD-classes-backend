# Copy this file to `.env` (gitignored) and fill in real values.
# Used by docker-compose.yml and by bootRun (via your shell).

# JWT signing key. MUST be at least 32 chars. Generate with:
#   openssl rand -base64 48
MD_JWT_SECRET=replace-me-with-at-least-32-random-chars-please

# CORS allowed origins (comma-separated list, e.g. http://localhost:3000,http://localhost:5173 or * for wildcard)
MD_ALLOWED_ORIGINS=*

# Local Postgres
MD_DB_URL=jdbc:postgresql://localhost:5432/md_portal
MD_DB_USER=postgres
MD_DB_PASSWORD=root123

# For docker-compose only
POSTGRES_DB=md_portal
POSTGRES_USER=md_portal
POSTGRES_PASSWORD=md_portal
